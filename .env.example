# Copy this file to .env.local and fill in values

# Supabase (public — safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase (server-only — NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend (server-only)
RESEND_API_KEY=re_your-api-key-here
RESEND_FROM_EMAIL=notifications@seattleluxurydrive.com
ADMIN_NOTIFICATION_EMAIL=your-admin-email@example.com

# Google Analytics (public)
NEXT_PUBLIC_GA_ID=G-NFP444PKQ5

# PostHog (public)
NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-key-here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Site URL (used for auth redirects — set to https://seattleluxurydrive.com in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
